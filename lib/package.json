{
  "name": "react-native-webengage",
  "version": "1.6.2",
  "description": "WebEngage React Native library.",
  "license": "MIT",
  "author": "WebEngage",
  "homepage": "https://docs.webengage.com/docs/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebEngage/react-native-webengage.git"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "jest"
  },
  "keywords": [
    "webengage",
    "react",
    "react-native",
    "analytics",
    "push",
    "in-app",
    "notification",
    "android",
    "ios"
  ],
  "peerDependencies": {
    "react-native": ">=0.65.0"
  },
  "codegenConfig": {
    "name": "WETurboModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.webengage"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/jest.mock.js"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-jest": "^30.1.2",
    "jest": "^30.1.3"
  }
}
