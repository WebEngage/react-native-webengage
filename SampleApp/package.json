{
  "name": "SampleApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx @react-native-community/cli run-android",
    "ios": "npx @react-native-community/cli run-ios --simulator='iPhone 17 Pro Max'",
    "lint": "eslint .",
    "start": "npx @react-native-community/cli start",
    "test": "jest",
    "pod-install": "cd ios && pod install && cd ..",
    "android:old": "./scripts/switch-architecture.sh old && cd android && ./gradlew clean && cd .. && npx @react-native-community/cli run-android",
    "android:new": "./scripts/switch-architecture.sh new && cd android && ./gradlew clean && cd .. && npx @react-native-community/cli run-android",
    "android:bridgeless": "./scripts/switch-architecture.sh bridgeless && cd android && ./gradlew clean && cd .. && npx @react-native-community/cli run-android",
    "ios:old": "./scripts/switch-architecture.sh old && cd ios && pod install && cd .. && npx @react-native-community/cli run-ios --simulator='iPhone 17 Pro'",
    "ios:new": "./scripts/switch-architecture.sh new && cd ios && pod install && cd .. && npx @react-native-community/cli run-ios --simulator='iPhone 17 Pro'",
    "ios:bridgeless": "./scripts/switch-architecture.sh bridgeless && cd ios && pod install && cd .. && npx @react-native-community/cli run-ios --simulator='iPhone 17 Pro'",
    "start:old": "npx @react-native-community/cli start",
    "start:new": "npx @react-native-community/cli start",
    "start:bridgeless": "npx @react-native-community/cli start",
    "switch:old": "./scripts/switch-architecture.sh old",
    "switch:new": "./scripts/switch-architecture.sh new",
    "switch:bridgeless": "./scripts/switch-architecture.sh bridgeless",
    "clear:ios": "./scripts/clear-ios.sh",
    "clear:android": "./scripts/clear-android.sh",
    "test:unit": "cd ../lib && npm test",
    "test:validate": "./scripts/quick-validate.sh",
    "test:all-android": "./scripts/test-all-architectures.sh android all",
    "test:all-ios": "./scripts/test-all-architectures.sh ios all",
    "test:all": "./scripts/test-all-architectures.sh both all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@react-navigation/stack": "^7.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.1",
    "react-native-bouncy-checkbox": "^4.1.2",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-modal": "^13.0.2",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "4.15.4",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-we-personalization": "^1.1.1",
    "react-native-webengage": "file:../lib",
    "react-native-webengage-inbox": "1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/runtime": "^7.27.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.79.1",
    "@react-native/eslint-config": "0.79.1",
    "@react-native/js-polyfills": "^0.79.1",
    "@react-native/metro-babel-transformer": "^0.79.1",
    "@react-native/metro-config": "^0.79.1",
    "@react-native/typescript-config": "0.79.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.2",
    "babel-jest": "^29.7.0",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "metro-config": "^0.82.2",
    "metro-runtime": "^0.82.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
